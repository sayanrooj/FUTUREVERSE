# ==============================================================================
# FUTUREVERSE Environment Configuration Example (.env.example)
# Copy this file to .env and configure your local or production settings
# ==============================================================================

APP_NAME=FUTUREVERSE
APP_CREATOR="Sayan Rooj"
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=futureverse-super-secret-key-sayan-rooj-2026-production-grade

# Database
DATABASE_URL=sqlite+aiosqlite:///./futureverse.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/futureverse

# Transactional Email (SMTP Configuration)
# Supported variables:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_SECURE=False
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-app-password
EMAIL_FROM=recruitment@futureverse.ai
EMAIL_FROM_NAME="FUTUREVERSE Recruitment"
ENABLE_REAL_EMAIL=False

# AI Cognitive Engine
AI_PROVIDER=futureverse-native
AI_MODEL=futureverse-cognitive-v2.6
AI_API_KEY=your-ai-key-here
